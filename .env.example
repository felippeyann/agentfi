# =============================================================================
# AgentFi — Environment Variables
# =============================================================================
# Copy this file to .env and fill in every required value before running.
# Variables marked "optional" can be left blank for local development.
# NEVER commit the real .env file to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Node environment: development | staging | production
NODE_ENV=development

# Port the Fastify API listens on
API_PORT=3000

# Operator secret used to authenticate agent-registration requests (POST /v1/agents).
# Must be at least 32 characters. Generate with: openssl rand -hex 32
API_SECRET=your-api-secret-min-32-chars-here

# Public self-registration rate limit (per IP, per hour).
# Lets autonomous agents bootstrap themselves via POST /v1/public/agents
# without the operator API_SECRET. Default 5; set to 0 to disable.
PUBLIC_REGISTRATION_RATE_LIMIT_PER_HOUR=5

# Port the MCP server listens on
MCP_PORT=3002

# API key the hosted MCP server will require on incoming SSE connections.
# Use the agent key for single-tenant MCP deployments.
AGENTFI_API_KEY=

# Allowed browser origin for hosted MCP SSE CORS. Set to your agent runtime origin.
# Example: https://claude.ai
MCP_CORS_ORIGIN=


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://agentfi:agentfi@localhost:5432/agentfi


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Redis connection string used for queues and caching.
REDIS_URL=redis://localhost:6379

# Transaction worker controls.
# Set false on API replicas when running a dedicated worker process/service.
# In production, backend defaults to false unless explicitly set.
TRANSACTION_WORKER_ENABLED=true

# Queue worker tuning (helpful for metered Redis providers like Upstash).
TRANSACTION_WORKER_CONCURRENCY=5
TRANSACTION_WORKER_DRAIN_DELAY_SEC=30
TRANSACTION_WORKER_STALLED_INTERVAL_MS=120000

# If Redis reports provider quota exhaustion (e.g., Upstash max requests),
# automatically stop the worker to prevent request burn and noisy error loops.
TRANSACTION_WORKER_STOP_ON_REDIS_QUOTA=true

# Rate-limit overrides (requests per minute per tier)
RATE_LIMIT_FREE=30
RATE_LIMIT_PRO=300
RATE_LIMIT_ENTERPRISE=3000


# -----------------------------------------------------------------------------
# RPC Providers
# -----------------------------------------------------------------------------

# Alchemy API key — used to build RPC URLs for all supported chains (required).
# Get yours at https://www.alchemy.com
ALCHEMY_API_KEY=your-alchemy-api-key-here

# Infura API key — fallback RPC provider (optional).
# Get yours at https://infura.io
INFURA_API_KEY=

# Per-chain RPC override (optional): RPC_URL_<chainId>, e.g. RPC_URL_8453,
# RPC_URL_84532, RPC_URL_1, RPC_URL_42161, RPC_URL_137. When set it becomes the
# PRIMARY RPC of that chain (self-hosted node, another provider, or a local
# Anvil fork such as the C5a escrow rehearsal); Alchemy, Infura and the public
# RPC stay behind it as fallbacks. http(s) only. Blank = unset.
RPC_URL_84532=


# -----------------------------------------------------------------------------
# Wallet Infrastructure
# -----------------------------------------------------------------------------
# Provider selection:
#   turnkey  — Turnkey MPC (production-grade, keys split across shards)
#   local    — in-memory viem keys (DEVELOPMENT ONLY — keys lost on restart;
#              refused at boot when NODE_ENV=production). Used by
#              docker-compose.dev.yml for zero-credential dev quickstart.
WALLET_PROVIDER=turnkey

# Turnkey credentials — REQUIRED when WALLET_PROVIDER=turnkey, ignored otherwise.
# Private key shards never leave Turnkey infrastructure.
# Dashboard: https://app.turnkey.com

# Turnkey API public key (P-256 compressed hex)
TURNKEY_API_PUBLIC_KEY=your-turnkey-api-public-key-here

# Turnkey API private key (P-256 hex) — treat like a password, never commit
TURNKEY_API_PRIVATE_KEY=your-turnkey-api-private-key-here

# Turnkey organization ID (UUID)
TURNKEY_ORGANIZATION_ID=your-turnkey-organization-id-here


# -----------------------------------------------------------------------------
# Wallet Infrastructure — Safe (smart wallets)
# -----------------------------------------------------------------------------
# Optional. When set, each new agent gets a Safe smart wallet deployed
# automatically with the AgentPolicyModule enabled.
# If left blank, agents use their Turnkey EOA address directly (fine for
# local development and testnets).
#
# Must be a funded EOA private key that has native gas tokens on every target
# chain (ETH on mainnet/Base/Arbitrum, MATIC on Polygon).
SAFE_DEPLOYER_PRIVATE_KEY=


# -----------------------------------------------------------------------------
# x402 payments (agent pays HTTP 402 resources)
# -----------------------------------------------------------------------------
# Optional facilitator override. When blank, the per-chain default applies:
#   Base Sepolia (84532) — https://x402.org/facilitator (testnet only, no auth)
#   Base (8453)          — https://api.cdp.coinbase.com/platform/v2/x402
#                          (Coinbase Developer Platform; needs a CDP API key,
#                          attached by the facilitator client in a later task)
# The buyer-side client (X402ClientService) never calls the facilitator —
# the resource server does — so this only matters where AgentFi sells or
# reconciles x402 settlements.
# Shipped commented out: uncomment only to override. (A blank value is also
# treated as unset, so a copied `.env` with `X402_FACILITATOR_URL=` still boots.)
# X402_FACILITATOR_URL=

# POST /v1/jobs/:id/pay-resource fetches a URL chosen by the provider agent.
# By default (false) it refuses any URL whose host is, or resolves to, a
# private, loopback, link-local or reserved address (cloud metadata, internal
# databases, the admin API), connects only to the addresses it validated, and
# never follows redirects — in every environment. Set true ONLY to pay a
# resource server you run on localhost during development; the backend
# refuses to boot with true when NODE_ENV is production or staging.
RESOURCE_PAYMENT_ALLOW_PRIVATE_HOSTS=false


# -----------------------------------------------------------------------------
# Simulation — Tenderly (optional)
# -----------------------------------------------------------------------------
# Used to simulate transactions before broadcasting.
# Leave blank to use the mock simulator in development/test. In production/
# staging the backend never mocks: it falls back to an eth_call/estimateGas
# dry-run against the chain RPC (a WARN is logged at boot).
# Dashboard: https://dashboard.tenderly.co

TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=


# -----------------------------------------------------------------------------
# Stripe (billing — PRO subscriptions at $99/month)
# -----------------------------------------------------------------------------
# Create products and webhooks in the Stripe dashboard, then paste the IDs here.
# Use sk_test_* / whsec_test_* keys for local development.
# Dashboard: https://dashboard.stripe.com

# Stripe secret key (sk_live_* for production, sk_test_* for development)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here

# Stripe webhook signing secret — obtained from the webhook endpoint settings
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# Stripe Price ID for the PRO monthly plan (price_*)
STRIPE_PRO_PRICE_ID=price_your-stripe-pro-price-id-here


# -----------------------------------------------------------------------------
# Revenue
# -----------------------------------------------------------------------------

# Ethereum address where protocol fees are collected
OPERATOR_FEE_WALLET=0xYourEthereumAddressHere


# -----------------------------------------------------------------------------
# Admin Dashboard
# -----------------------------------------------------------------------------

# Secret header value required to access /admin/* routes (x-admin-secret).
# Must be kept private — this grants full read/write access to all agent data.
# Generate with: openssl rand -hex 32
ADMIN_SECRET=your-admin-secret-min-32-chars-here

# Local-only admin by default. Set true only when you intentionally expose admin remotely.
ADMIN_ALLOW_REMOTE=false

# Admin UI operator credentials (NextAuth credentials provider).
# These credentials are required to access the admin dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-production

# Login brute-force controls (process-local limiter for NextAuth credentials).
# Defaults: 5 attempts in 10 min, then 30 min lockout for username+IP fingerprint.
ADMIN_AUTH_MAX_ATTEMPTS=5
ADMIN_AUTH_WINDOW_MS=600000
ADMIN_AUTH_LOCKOUT_MS=1800000

# NextAuth secret for the admin frontend session encryption.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-here

# Public URL of the admin frontend (used for NextAuth callbacks)
NEXTAUTH_URL=http://localhost:3001

# ── Optional OAuth / OIDC providers (alongside credentials) ──────────────────
# When configured, operators can sign in via GitHub/Google in addition to
# username/password. You MUST also set ADMIN_OAUTH_ALLOWLIST to restrict which
# emails are allowed to sign in.

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of email addresses allowed to sign in via OAuth.
# If empty, OAuth logins are rejected (fail-closed).
# Example: alice@company.com,bob@company.com
ADMIN_OAUTH_ALLOWLIST=

# Admin frontend base URL
ADMIN_URL=http://localhost:3001

# CORS allowed origins (comma-separated). In production, set to your admin domain.
# Example: https://admin.agentfi.cc
# Default (when not set): https://admin.agentfi.cc
CORS_ORIGIN=https://admin.agentfi.cc

# Backend API base URL (used by the admin frontend to make API calls)
BACKEND_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Operator Notifications
# -----------------------------------------------------------------------------
# When set, the backend posts JSON payloads for PENDING_APPROVAL / TRANSACTION_*
# events to the configured channels.

# Generic webhook URL (any HTTP endpoint that accepts POST JSON — e.g. n8n, Zapier)
OPERATOR_NOTIFICATION_WEBHOOK=

# Discord: paste a Discord channel webhook URL
# https://support.discord.com/hc/en-us/articles/228383668
OPERATOR_DISCORD_WEBHOOK=

# Telegram: create a bot via @BotFather, then set both values
# OPERATOR_TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# OPERATOR_TELEGRAM_CHAT_ID=-100your-chat-id
OPERATOR_TELEGRAM_BOT_TOKEN=
OPERATOR_TELEGRAM_CHAT_ID=


# -----------------------------------------------------------------------------
# Contracts (populated after on-chain deployment)
# -----------------------------------------------------------------------------
# Leave blank until the contracts are deployed. Each variable follows the
# pattern: <CONTRACT>_ADDRESS_<CHAIN_ID>
#
# Supported chain IDs:
#   1      — Ethereum Mainnet
#   8453   — Base
#   42161  — Arbitrum One
#   137    — Polygon
#   84532  — Base Sepolia (testnet)
#
# ABI VERSIONING (October 2026): AgentExecutor.Action gained a `token` field, so
# the backend now encodes executeSingle/executeBatch with the new selectors.
# Contracts deployed BEFORE that change expose the old selectors and revert on
# every transaction routed through the executor. Known legacy pairs — do NOT
# use them with this backend version:
#   Base (8453):          policy 0x03afE9c56331EE6A795C873a5e7E23308F6f6A6d
#                         executor 0x54415F0Bc61436193D2a8dD00e356eD9EBfd24b3
#   Base Sepolia (84532): policy 0x771444Ff5483ef3A62b492a816Cb439e4f017203
#                         executor 0x1fE2A4e79899A9cB03bED301f978d2Ce2F91Fc5d
# Redeploy from packages/contracts (docs/operations/contract-deployment.md,
# "ABI versioning") and paste the NEW addresses below. The backend logs a WARN
# at boot and `npm run preflight` fails if a legacy address is configured.

# AgentPolicyModule contract addresses
POLICY_MODULE_ADDRESS_1=
POLICY_MODULE_ADDRESS_8453=
POLICY_MODULE_ADDRESS_42161=
POLICY_MODULE_ADDRESS_137=
POLICY_MODULE_ADDRESS_84532=

# Executor contract addresses
EXECUTOR_ADDRESS_1=
EXECUTOR_ADDRESS_8453=
EXECUTOR_ADDRESS_42161=
EXECUTOR_ADDRESS_137=
EXECUTOR_ADDRESS_84532=

# EscrowModule contract addresses (A2A job escrow). Optional — leave blank to
# run without on-chain escrow. Deploy.s.sol prints all three per chain.
ESCROW_MODULE_ADDRESS_1=
ESCROW_MODULE_ADDRESS_8453=
ESCROW_MODULE_ADDRESS_42161=
ESCROW_MODULE_ADDRESS_137=
ESCROW_MODULE_ADDRESS_84532=

# ERC-8183 escrow (AgentJobEscrow) + ERC-8004 hook (ReputationHook), as printed
# by `forge script script/DeployEscrow.s.sol` (docs/operations/contract-deployment.md,
# "ERC-8183 escrow and ERC-8004 hook"). Setting AGENT_JOB_ESCROW_ADDRESS_<chainId>
# switches paid A2A jobs on that chain to the on-chain escrow flow — USDC only
# (decision D8). The hook is optional: leave it blank to create jobs without one.
AGENT_JOB_ESCROW_ADDRESS_1=
AGENT_JOB_ESCROW_ADDRESS_8453=
AGENT_JOB_ESCROW_ADDRESS_42161=
AGENT_JOB_ESCROW_ADDRESS_137=
AGENT_JOB_ESCROW_ADDRESS_84532=
REPUTATION_HOOK_ADDRESS_1=
REPUTATION_HOOK_ADDRESS_8453=
REPUTATION_HOOK_ADDRESS_42161=
REPUTATION_HOOK_ADDRESS_137=
REPUTATION_HOOK_ADDRESS_84532=

# Evaluator signer for ERC-8183 jobs (decision D5): the backend is the
# `evaluator` of every job and signs complete / reject / claimRefund with this
# key. Its address is logged at boot as `escrowEvaluatorAddress` — pass the same
# address as TRUSTED_EVALUATOR when deploying the hook. Needs native gas on every
# escrow chain. REQUIRED in staging/production when an escrow address is set;
# in development the escrow flow stays disabled without it.
ESCROW_EVALUATOR_PRIVATE_KEY=

# Job TTL: `expiredAt = now + TTL` at createJob; after it anyone may claimRefund
# a Funded/Submitted job (default 7 days).
ESCROW_JOB_TTL_SECONDS=604800

# Grace period (seconds) between the provider's `submit` confirming and the
# evaluator sending `complete`, during which the requester may contest
# (POST /v1/jobs/:id/contest). Default 0 = settle as soon as possible.
ESCROW_EVALUATION_DELAY_SECONDS=0

# Public base URL of this API — used for the on-chain job description and the
# ERC-8004 feedbackURI (<BACKEND_PUBLIC_URL>/v1/jobs/<id>/feedback.json).
BACKEND_PUBLIC_URL=http://localhost:3000

# ERC-8004 identity (R2). On a chain with AGENT_JOB_ESCROW_ADDRESS_<chainId>
# AND REPUTATION_HOOK_ADDRESS_<chainId>, the provider of a funded job gets an
# ERC-8004 identity: its own wallet calls register(agentURI) on its first funded
# job (decision D7; needs a little native gas) and then setProviderAgentId on
# the job, so the hook writes feedback at settlement. agentURI =
# <BACKEND_PUBLIC_URL>/v1/agents/<id>/erc8004.json. Leave the registry blank to
# use the official deployment (Base 8453: 0x8004A169…a432, Base Sepolia 84532:
# 0x8004A818…BD9e); it MUST be the registry the hook was deployed with. Other
# chains have no default: the identity step is SKIPPED there unless set.
IDENTITY_REGISTRY_ADDRESS_1=
IDENTITY_REGISTRY_ADDRESS_8453=
IDENTITY_REGISTRY_ADDRESS_42161=
IDENTITY_REGISTRY_ADDRESS_137=
IDENTITY_REGISTRY_ADDRESS_84532=
# Optional public MCP endpoint advertised as the "MCP" service in every agent's
# registration file (e.g. https://api.example.com/mcp/sse). Omitted when blank.
MCP_PUBLIC_URL=


# -----------------------------------------------------------------------------
# ENS Persistent Identity (optional)
# -----------------------------------------------------------------------------
# When set, each new agent gets a subdomain of the form
# `<slug>-<id-suffix>.<ENS_PARENT_DOMAIN>` pointing to its Safe address.
# Leaving these blank disables the feature — agent registration still
# works, they just have `ensName: null` in the API response.
#
# The controller wallet must own (or be approved on) the parent domain
# and hold enough native currency to pay for 2 txs per registration
# (setSubnodeRecord on the ENS registry + setAddr on the resolver).
ENS_PARENT_DOMAIN=
ENS_CONTROLLER_PRIVATE_KEY=
ENS_CHAIN_ID=1
# Optional — override the public resolver address. Defaults to the canonical
# ENS public resolver on mainnet (1) and Sepolia (11155111). Required on any
# other chain you point ENS_CHAIN_ID at.
ENS_PUBLIC_RESOLVER=
