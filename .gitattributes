# Generated by `npm run spec:types` (openapi-typescript), which writes LF.
# Keep LF in every checkout so `npm run spec:check` compares like with like
# on Windows too (core.autocrlf=true would otherwise check it out as CRLF).
packages/mcp-server/src/api.generated.ts text eol=lf

# Solidity sources are LF in the index; keep them LF in every checkout so `forge fmt --check` passes on Windows
# (core.autocrlf=true would otherwise check them out as CRLF).
*.sol text eol=lf

# Vendored third-party sources (packages/invoice-agent/erc8004/vendor): byte-for-byte upstream, LF, never normalized.
packages/invoice-agent/erc8004/vendor/** -text
