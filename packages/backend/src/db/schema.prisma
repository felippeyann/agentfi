generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id           String      @id @default(cuid())
  name         String
  apiKeyHash   String      @unique
  apiKeyPrefix String
  walletId     String      @unique
  safeAddress  String      @unique
  chainIds     Int[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  active       Boolean     @default(true)
  tier         AgentTier   @default(FREE)
  /// JSON manifest of services/tools this agent provides to other agents
  serviceManifest Json?

  // Reputation & Trust Metrics
  reputationScore Int      @default(0)
  a2aTxCount      Int      @default(0)
  lastActiveAt    DateTime @default(now())

  // Economic identity — optional ENS subdomain (e.g., "alice.agentfi.eth")
  // pointing to the agent's Safe address. Null when ENS isn't configured
  // for this operator or subdomain registration failed.
  ensName         String?  @unique

  // Revenue sharing — optional link to the operator that manages this agent
  operatorId      String?
  operator        Operator? @relation(fields: [operatorId], references: [id])

  transactions Transaction[]
  requestedJobs Job[]      @relation("RequestedJobs")
  providedJobs  Job[]      @relation("ProvidedJobs")
  resourcePayments ResourcePayment[]
  identities   AgentIdentity[]
  policy       AgentPolicy?
  billing      AgentBilling?

  @@index([apiKeyHash])
  @@index([operatorId])
}

model Operator {
  id               String    @id @default(cuid())
  name             String
  walletAddress    String    @unique
  contactEmail     String?
  revShareBps      Int       @default(2000)  // 20% of protocol fees
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  agents           Agent[]
  revenueAccruals  OperatorRevenue[]
  settlements      OperatorSettlement[]
}

model OperatorRevenue {
  id               String    @id @default(cuid())
  operatorId       String
  operator         Operator  @relation(fields: [operatorId], references: [id])
  feeEventId       String
  grossFeeUsd      String
  operatorShareUsd String
  protocolShareUsd String
  shareBps         Int
  accrualDate      String    // YYYY-MM-DD
  settled          Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([operatorId])
  @@index([accrualDate])
  @@index([settled])
}

model OperatorSettlement {
  id               String    @id @default(cuid())
  operatorId       String
  operator         Operator  @relation(fields: [operatorId], references: [id])
  amountUsd        String
  txHash           String?
  chainId          Int?
  periodStart      String    // YYYY-MM-DD
  periodEnd        String    // YYYY-MM-DD
  status           SettlementStatus @default(PENDING)
  createdAt        DateTime  @default(now())
  settledAt        DateTime?

  @@index([operatorId])
  @@index([status])
}

enum SettlementStatus {
  PENDING
  PROCESSING
  SETTLED
  FAILED
}

// A2A Service Request / Job Queue
model Job {
  id           String    @id @default(cuid())
  requesterId  String
  requester    Agent     @relation("RequestedJobs", fields: [requesterId], references: [id], onDelete: Cascade)
  providerId   String
  provider     Agent     @relation("ProvidedJobs", fields: [providerId], references: [id], onDelete: Cascade)
  
  status       JobStatus @default(PENDING)
  payload      Json      // The task details (e.g., { "action": "analyze", "target": "0x..." })
  reward       Json?     // Payment terms (e.g., { "amount": "0.01", "token": "ETH" })
  
  signature    String?   // Requester's signature of the payload
  result       Json?     // The output/proof of work from the provider
  resourcePayments ResourcePayment[]

  // v2 Escrow — funds committed at job creation, released on terminal state
  reservedAmount    String?   // Amount in human-readable units (same as reward.amount)
  reservedToken     String?   // Token symbol or address ("ETH" or 0x...)
  reservedChainId   Int?      // Chain where funds are reserved
  reservedAt        DateTime? // Reservation timestamp
  reservationStatus String?   // "PENDING" | "RELEASED" | "CANCELLED"

  // Phase 2 of #71 — revenue snapshot captured at payment confirmation.
  // NULL on a COMPLETED job ⇒ oracle was unresolved at finalization;
  // PnLService falls back to live pricing and surfaces a warning.
  rewardUsd      String?   // Total USD value of the reward at completion
  rewardPriceUsd String?   // Price-per-token-unit at completion (e.g. ETH/USD)

  // ── ERC-8183 escrow (C3, migration 0014) ─────────────────────────────────
  // Populated only when the job runs on `AgentJobEscrow` (escrowKind = "erc8183");
  // NULL for legacy / free jobs. See docs/architecture/erc-8183-mapping.md §6.
  escrowKind        String?   // "erc8183"
  escrowChainId     Int?
  escrowContract    String?   // AgentJobEscrow address (checksummed)
  onChainJobId      String?   // uint256 job id as a decimal string
  onChainStatus     String?   // CREATING | OPEN | BUDGET_SET | APPROVED | FUNDED | SUBMITTED | SETTLING | COMPLETED | REJECTED | EXPIRED | FAILED
  evaluator         String?   // operator/backend signer address (decision D5)
  budgetToken       String?   // escrow ERC-20 (USDC) address
  budgetAmount      String?   // budget in token base units (6 decimals for USDC)
  expiresAt         DateTime? // on-chain `expiredAt`
  deliverableHash   String?   // keccak256(JSON.stringify(result)) passed to `submit`
  settleTxHash      String?   // evaluator's complete / reject / claimRefund tx
  platformFeeAmount String?   // PlatformFeeAccrued amount (base units) on completion
  feedbackStatus    String?   // "written" | "skipped:<reason>" | "failed"
  feedbackFile      Json?     // ERC-8004 feedback file, generated once before settlement
  contestedAt       DateTime? // requester contested before settlement → evaluator rejects
  contestReason     String?
  escrowError       String?   // last escrow step / settlement error
  // ERC-8004 identity binding (R2, migration 0015): the provider's ERC-8004
  // agent id attached to the on-chain job with `setProviderAgentId`, so the
  // ReputationHook can write feedback on settlement. Never blocks payment.
  providerAgentId       String?   // uint256 agentId (decimal string) sent to setProviderAgentId
  providerAgentIdStatus String?   // BINDING | BOUND | FAILED | SKIPPED (NULL: job predates R2 / not escrowed)
  providerAgentIdError  String?   // why the binding FAILED or was SKIPPED
  deferredSubmitAt      DateTime? // provider PATCHed COMPLETED while BINDING: `submit` waits for the binding to end
  // ── end ERC-8183 escrow ───────────────────────────────────────────────────

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@index([reservationStatus])
  @@unique([escrowContract, onChainJobId])
  @@index([onChainStatus])
  @@index([expiresAt])
}

enum JobStatus {
  PENDING
  ACCEPTED
  COMPLETED
  FAILED
  CANCELLED
  PAYMENT_PENDING  // Provider marked work done; on-chain payment in flight. Not counted as revenue.
  PAYMENT_FAILED   // Payment broadcast failed/reverted; escrow refunded to requester.
}

// Subscription tiers — drives rate limits and fee rates
enum AgentTier {
  FREE       // 100 tx/month, 0.3% protocol fee
  PRO        // 10,000 tx/month, 0.15% protocol fee — $99/month
  ENTERPRISE // Unlimited tx/month, 0.05% protocol fee — custom pricing
}

// Per-agent billing record (subscription + accumulated fees)
model AgentBilling {
  id                    String    @id @default(cuid())
  agentId               String    @unique
  agent                 Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  subscriptionActive    Boolean   @default(false)
  subscriptionPeriodEnd DateTime?
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  // Protocol fees collected from this agent (in USD, as string)
  totalFeesCollectedUsd String    @default("0")
  // Tx count this billing period
  txCountThisPeriod     Int       @default(0)
  periodStart           DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  feeEvents FeeEvent[]
}

// Immutable log of each fee collected
model FeeEvent {
  id            String       @id @default(cuid())
  billingId     String
  billing       AgentBilling @relation(fields: [billingId], references: [id])
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  feeUsd        String       // fee amount in USD
  feeTokens     String       // fee in native token units (wei)
  feeBps        Int          // basis points applied
  collectedAt   DateTime     @default(now())

  @@index([billingId])
  @@index([transactionId])
  @@index([collectedAt(sort: Desc)])
}

model AgentPolicy {
  id                        String    @id @default(cuid())
  agentId                   String    @unique
  agent                     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  maxValuePerTxEth          String    @default("1.0")
  maxValueForAutoApprovalEth String    @default("0.1")
  maxDailyVolumeUsd         String    @default("10000")
  allowedContracts  String[]
  allowedTokens     String[]
  cooldownSeconds   Int       @default(60)
  active            Boolean   @default(true)
  /// Optional expiry for temporary task-scoped policies (null = no expiration)
  expiresAt         DateTime?
  /// Set by the admin kill switch (POST /admin/agents/:id/pause) when it flipped
  /// an *active* policy to inactive; the admin resume re-activates the policy
  /// only while this is set, then clears it. Null when the policy was
  /// deactivated by anything else (agent soft-delete, PATCH active=false) —
  /// those are never undone by resume. Migration 0017.
  pausedByOperatorAt DateTime?
  updatedAt         DateTime  @updatedAt
}

/// Tracks consumed x402 payment nonces to prevent replay attacks
model X402Nonce {
  id        String    @id @default(cuid())
  nonce     String    @unique
  chainId   Int
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([nonce])
  @@index([createdAt])
}

model Transaction {
  id             String    @id @default(cuid())
  idempotencyKey String?
  // System-supplied deterministic idempotency key for internal callers
  // (A2A payments, recovery worker). Globally unique. NULL for txs that
  // don't need server-side replay protection. See migration 0009.
  intentId       String?   @unique
  agentId        String
  agent          Agent     @relation(fields: [agentId], references: [id])
  chainId        Int
  txHash         String?   @unique
  status         TxStatus  @default(QUEUED)
  type           TxType
  fromToken      String?
  toToken        String?
  amountIn       String?
  amountOut      String?
  gasUsed        String?
  gasPrice       String?
  effectiveGasPriceWei String?
  error          String?
  simulation     Json?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  confirmedAt    DateTime?

  feeEvents  FeeEvent[]

  @@index([agentId, createdAt(sort: Desc)])
  @@unique([agentId, idempotencyKey])
  @@index([status])
  @@index([txHash])
}

model DailyVolume {
  id        String   @id @default(cuid())
  agentId   String
  date      String   // YYYY-MM-DD
  volumeUsd String   @default("0")
  updatedAt DateTime @updatedAt

  @@unique([agentId, date], name: "agentId_date")
  @@index([date])
}

enum TxStatus {
  PENDING
  PENDING_APPROVAL
  SIMULATING
  QUEUED
  SUBMITTED
  CONFIRMED
  FAILED
  REVERTED
}

enum TxType {
  SWAP
  TRANSFER
  DEPOSIT
  WITHDRAW
  APPROVE
  BATCH
  GMX_OPEN
  GMX_CLOSE
  ESCROW_LOCK
  ESCROW_RELEASE
  ESCROW_REFUND
  ESCROW_SUBMIT   // ERC-8183: provider's `submit(jobId, deliverable)` (migration 0014)
  ERC8004_IDENTITY // ERC-8004: provider's `register(agentURI)` and `setProviderAgentId` (migration 0015)
}

/// ERC-8004 identity of an agent in one chain's Identity Registry (R2).
/// Minted lazily from the agent's own wallet on its first funded job as a
/// provider (decision D7), so `ownerOf(agentId) == job.provider`.
model AgentIdentity {
  id             String              @id @default(cuid())
  agentId        String
  agent          Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  chainId        Int
  /// Identity Registry address (checksummed) the id was minted in.
  registry       String
  /// ERC-721 tokenId from the `Registered` event (decimal string); NULL until confirmed.
  erc8004AgentId String?
  status         AgentIdentityStatus
  /// agentURI passed to `register` (`<BACKEND_PUBLIC_URL>/v1/agents/<id>/erc8004.json`).
  agentURI       String
  registerTxHash String?
  error          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([agentId, chainId])
  @@unique([chainId, registry, erc8004AgentId])
  @@index([status])
}

enum AgentIdentityStatus {
  REGISTERING // claimed; `register` enqueued or in flight
  REGISTERED  // `Registered` parsed from the receipt; erc8004AgentId set
  FAILED      // register reverted / blocked / retries exhausted; the next funded job retries
}

/// x402 payment made by a job's provider for a third-party HTTP 402 resource,
/// charged against that job's reward budget (plan tasks P2 / P5).
///
/// State machine (terminal states never change, except `unknown → settled`
/// through a future reconciliation task):
///   reserved → pending → settled | unknown | refused
///   failed_before_signing (402 parse / budget / scheme errors before any signature)
model ResourcePayment {
  id                 String                @id @default(cuid())
  jobId              String
  job                Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Payer — always the job's provider.
  agentId            String
  agent              Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Origin + path only: query string, fragment and userinfo are stripped before storage.
  url                String
  method             String
  /// CAIP-2 network of the accepted payment option (e.g. `eip155:84532`).
  network            String
  /// Token contract of the accepted option (USDC on the job's chain).
  asset              String
  /// Price in the asset's base units (e.g. `"400000"` = 0.40 USDC).
  amount             String
  payTo              String
  /// x402 `payment-identifier` id; unique per job. Caller-supplied or a server UUID.
  paymentId          String
  /// EIP-3009 / Permit2 nonce of the signed authorization (set once signed).
  authorizationNonce String?
  status             ResourcePaymentStatus
  /// Raw `offer-receipt` receipt from the resource server, when provided.
  receipt            Json?
  /// True when the receipt verified against the accepted offer; false = marked unverified.
  receiptVerified    Boolean?
  /// Settlement tx hash as reported by the server (receipt or PAYMENT-RESPONSE); often absent.
  settlementTxHash   String?
  /// HTTP status of the paid response, when one was received.
  responseStatus     Int?
  error              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([jobId, paymentId])
  @@index([jobId])
  @@index([status])
}

enum ResourcePaymentStatus {
  reserved              // row created, budget checked, nothing signed yet
  pending               // authorization signed and sent to the resource server
  settled               // 2xx with a settlement report (receipt verified or marked unverified)
  unknown               // timeout / transport error after signing: money may have moved; no automatic retry
  refused               // server answered 4xx/5xx after signing, no settlement
  failed_before_signing // 402 parse / budget / scheme error before any signature
}
