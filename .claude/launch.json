{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/tsx/dist/cli.mjs", "watch", "packages/backend/src/index.ts"],
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/next/dist/bin/next", "dev", "--port", "3001", "packages/admin"],
      "port": 3001
    },
    {
      "name": "mcp-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/tsx/dist/cli.mjs", "watch", "packages/mcp-server/src/index.ts"],
      "port": 3002
    }
  ]
}
